{
  "schemaVersion": 1,
  "id": "universal-tool-apis",
  "version": "${version}",
  "name": "Universal Tool APIs",
  "description": "Universal crowbar, wrench, screwdriver, shears, shield and ranged-weapon APIs with registration systems and extensible hooks.",
  "authors": ["Alex"],
  "license": "MIT",
  "environment": "*",
  "provides": [
    "universal-crowbar-api",
    "universal-wrench-api",
    "universal-screwdriver-api",
    "universal-shears-api",
    "material-shears",
    "shield_api",
    "ranged_weapon_api",
    "universal-shield-api",
    "universal-ranged-weapon-api"
  ],
  "entrypoints": {
    "main": [
      "com.alex.universalcrowbarapi.UniversalCrowbarApiMod",
      "com.alex.universalwrenchapi.UniversalWrenchApiMod",
      "com.alex.universalshearsapi.UniversalShearsApiMod",
      "com.alex.universalshieldapi.UniversalShieldApiMod",
      "com.alex.universalrangedweaponapi.UniversalRangedWeaponApiMod"
    ]
  },
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {"techreborn": "*"}
}